# ═══════════════════════════════════════════════════════════
# AI-PM 部署配置模板
# 复制为 .env 并填入实际值: cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ═══ 1. 部署模式 ══════════════════════════════════════════
# 取消注释以启用 Redis（需 docker compose --profile full up）
# COMPOSE_PROFILES=full


# ═══ 2. PostgreSQL 数据库 ══════════════════════════════════
POSTGRES_USER=ai_pm
POSTGRES_PASSWORD=<REQUIRED: 设置强密码>
POSTGRES_DB=ai_pm

# 后端数据库连接 URL（compose 自动拼接，通常无需修改）
# 仅连接外部数据库时才需覆盖此项
AI_PM_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}


# ═══ 3. Redis（可选）═══════════════════════════════════════
# AI_PM_REDIS_URL=redis://redis:6379/0


# ═══ 4. JWT 密钥 ══════════════════════════════════════════
# 生成方式: openssl rand -hex 32
AI_PM_JWT_SECRET=<REQUIRED: 生成随机字符串>
# Token 过期时间（分钟），默认 1440（24小时）
# AI_PM_JWT_EXPIRE_MINUTES=1440


# ═══ 5. LLM 网关 ══════════════════════════════════════════
# 内网部署时，改为内部 LLM 网关地址
AI_PM_LLM_GATEWAY_URL=<REQUIRED: 例如 http://your-llm-gateway:8080/v1>
# LLM API Key（如网关需要）
# AI_PM_LLM_API_KEY=


# ═══ 6. LDAP 认证（可选）═══════════════════════════════════
# 取消注释并填写内网 LDAP 服务器信息
# AI_PM_LDAP_ENABLED=True
# AI_PM_LDAP_SERVER_URI=ldap://ldap.company.internal:389
# AI_PM_LDAP_BIND_DN=cn=admin,dc=company,dc=com
# AI_PM_LDAP_BIND_PASSWORD=
# AI_PM_LDAP_BASE_DN=ou=users,dc=company,dc=com
# AI_PM_LDAP_USER_FILTER=(uid={username})


# ═══ 7. 内网镜像源（仅内网构建时使用）═════════════════════
# 仅在 docker build / docker compose build 前设置，运行时不需要
# 用法: set -a && source .env && set +a && docker compose build

## Debian APT 镜像（IP 或域名，不含协议）
# APT_MIRROR=mirrors.company.internal
# APT_MIRROR_PROTOCOL=http

## Python pip 镜像（安装 uv 用）
# PIP_INDEX_URL=http://mirrors.company.internal/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.company.internal

## uv 镜像（项目依赖）
# UV_INDEX_URL=http://mirrors.company.internal/pypi/simple/

## Node.js npm 镜像（前端构建）
# NPM_REGISTRY=http://mirrors.company.internal/npm/
# NPM_STRICT_SSL=false


# ═══ 8. 日志 ══════════════════════════════════════════════
# Docker json-file 日志轮转配置
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5


# ═══ 9. 其他 ══════════════════════════════════════════════
# 后端对外访问地址（用于生成链接等）
# AI_PM_API_BASE_URL=http://your-server-ip
# Git 仓库存储路径（容器内）
# AI_PM_GIT_REPOS_PATH=/app/repos
# 文件上传存储路径（容器内）
# AI_PM_UPLOADS_PATH=/app/uploads
