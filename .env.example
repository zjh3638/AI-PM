# ── Database ───────────────────────────────────────────
# PostgreSQL 连接字符串（格式: postgresql+asyncpg://user:pass@host:5432/dbname）
AI_PM_DATABASE_URL=postgresql+asyncpg://ai_pm:change_me@postgres:5432/ai_pm

# ── Redis ──────────────────────────────────────────────
AI_PM_REDIS_URL=redis://redis:6379/0

# ── JWT ────────────────────────────────────────────────
# 务必修改为随机字符串！
AI_PM_JWT_SECRET=change-me-to-a-random-secret-string

# ── LLM Gateway ────────────────────────────────────────
# LLM API 网关地址（OpenAI 兼容接口）
AI_PM_LLM_GATEWAY_URL=https://api.deepseek.com/v1

# ── LDAP（可选，默认关闭）──────────────────────────────
# AI_PM_LDAP_ENABLED=True
# AI_PM_LDAP_SERVER_URI=ldap://ldap.company.com:389
# AI_PM_LDAP_BIND_DN=cn=admin,dc=company,dc=com
# AI_PM_LDAP_BIND_PASSWORD=secret
# AI_PM_LDAP_BASE_DN=ou=users,dc=company,dc=com
# AI_PM_LDAP_USER_FILTER=(uid={username})

# ── Other ──────────────────────────────────────────────
# AI_PM_API_BASE_URL=http://your-server-ip:8000
# AI_PM_GIT_REPOS_PATH=/app/repos
