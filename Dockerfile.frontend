# ── Builder stage: build frontend from monorepo root ─────
FROM 7.24.4.68:28085/1ms/node:22-alpine AS builder

ARG NPM_REGISTRY=""
ARG NPM_STRICT_SSL="true"

# Configure npm registry (use intranet registry, no proxy needed)
RUN if [ -n "$NPM_REGISTRY" ]; then \
      npm config set registry "$NPM_REGISTRY" && \
      npm config set strict-ssl "$NPM_STRICT_SSL"; \
    fi

# Install pnpm globally (corepack downloads from npmjs.org, bypasses intranet registry)
RUN npm install -g pnpm@9.15.0

WORKDIR /app

# Copy monorepo root config
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./

# Copy frontend app source
COPY apps/web/ ./apps/web/

# Install dependencies (pnpm respects npm registry config)
# --frozen-lockfile ensures production-identical builds
RUN pnpm install --frozen-lockfile

# Build the frontend app
RUN pnpm build --filter=@ai-pm/web


# ── Runtime stage: nginx serving static files ────────────
FROM 7.24.4.68:28085/1ms/nginx:alpine

# Copy built assets
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/health || exit 1
